G2_DEV_ENV_NAME=test
G2_DEV_API_TARGET=https://cube-test.guhecloud.com:3000
# Optional preferred port for the local migration BFF; the next free port is used automatically.
# G2_DEV_BFF_PORT=3031
# The test environment is legacy qiankun based. Leave this unset to use the
# repository-generated complete local Profile plus target-environment qiankun apps.
# Set this only when the target environment provides a valid resolved G2 Profile.
# G2_DEV_PROFILE_URL=https://cube-uat.guhecloud.com:3000/compositions/prod.resolved.json
# G2_DEV_ALLOW_PRODUCTION=1
# Allow another machine on your LAN to open the Shell (read-only /__g2_dev).
# Remote registration / unregister still requires loopback.
# G2_DEV_ALLOW_LAN=1
