{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client", "bun-types", "vue/jsx"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite.config.ts"]
}
