    "@g2-contract/auth": "workspace:*",
    "@g2-contract/file": "workspace:*",
    "@g2-contract/mdata": "workspace:*",
    "@g2-contract/ouaa": "workspace:*",
    "@g2-domain/poc-inline-pc": "workspace:*",
    "@g2-runtime/common-loader": "workspace:*",
    "@module-federation/enhanced": "catalog:vite",
    "pinia": "catalog:vue",
    "qiankun": "catalog:legacy",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue",
    "yaml": "catalog:libs"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@g2-platform/logger": "workspace:*",
    "@g2-platform/resource": "workspace:*",
    "@g2-tooling/mf-vite": "workspace:*",
    "@tailwindcss/vite": "catalog:vite",
    "@vitejs/plugin-vue-jsx": "catalog:vite",
    "@vue/test-utils": "catalog:vite",
    "crypto-js": "catalog:libs",
    "dayjs": "catalog:libs",
    "jsdom": "catalog:vite",
    "tailwindcss": "catalog:vite",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:vite"
  }
