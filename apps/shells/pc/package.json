{
  "name": "@g2-shell/pc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./stores/portal-navigation": "./src/stores/portal-navigation.ts"
  },
  "scripts": {
    "dev": "bun ../../../tooling/dev-link/shell.ts",
    "dev:serve": "node ./node_modules/vite/bin/vite.js",
