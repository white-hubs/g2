    "preview": "bun --bun vite preview --port 5100 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@g2-composition/contract": "workspace:*",
    "@g2-composition/loader": "workspace:*",
    "@g2-composition/registry": "workspace:*",
