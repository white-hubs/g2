# MinIO (compose services + host-side release CLI)
# Image pinned in docker-compose.yaml: minio/minio:RELEASE.2022-07-17T15-43-14Z
# (multi-arch incl. arm64; do not bump to later community tags)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# nginx gateway (main site) + CDN edge (webReleaseBase) + BFF
GATEWAY_HOST_PORT=8080
CDN_HOST_PORT=8081
BFF_HOST_PORT=3030
# docker build secret for Nexus (default: repo .npmrc)
# NPMRC_FILE=/path/to/.npmrc
# BFF base image (compose defaults to DaoCloud mirror — Docker Hub auth often times out in CN)
# BFF_BASE_IMAGE=docker.m.daocloud.io/oven/bun:1.3.14
# BFF_BASE_IMAGE=oven/bun:1.3.14

# Address template keys for `release generate` (same names as deploy/address-templates/*.yaml; ADR-0055)
webReleaseBase=http://localhost:8081
backendApi=
staticResourceBase=https://r.kaiheai.com

# Host-side @g2-tooling/release CLI (points at compose MinIO on localhost)
RELEASE_S3_ENDPOINT=http://127.0.0.1:9000
RELEASE_S3_REGION=us-east-1
RELEASE_S3_BUCKET=g2-web-release
RELEASE_S3_ACCESS_KEY=minioadmin
RELEASE_S3_SECRET_KEY=minioadmin
RELEASE_S3_FORCE_PATH_STYLE=true

# Backend API upstream for /api /third-auth /resource /apps-legacy /apps
# Copy to .env and point at your API (host-local example below; HTTPS upstreams need a real Host).
API_UPSTREAM=https://cube-test.guhecloud.com:30000
API_UPSTREAM_HOST=cube-test.guhecloud.com
# /gw-bff/* — default is compose service `bff` (http://bff:3000). Override only if needed:
BFF_UPSTREAM=http://bff:3000
BFF_UPSTREAM_HOST=bff
BFF_DAILY_TASK_URL=http://gateway/api
BFF_VIDEO_MONITOR_URL=https://cube-test.guhecloud.com:3000/gw-bff/video-monitor

# @g2-server/bff process (compose service `bff`)
# OAUTH_CLIENT_SECRET is required for POST /gw-bff/auth/token (BFF injects client_id/secret;
# browser must NOT send them). Copy from old gateway ignored app.json / ops vault — never commit.
OAUTH_CLIENT_ID=client_2
OAUTH_CLIENT_SECRET=cli@two@pwd#ghcloud!2026
BFF_OUAA_URL=http://gateway/api/ouaa
BFF_DEVICE_CENTER_URL=http://gateway/api/device-center
BFF_DICTIONARY_URL=http://gateway/api/dictionary
# Diagnose: bash tooling/diagnose-bff-token.sh
